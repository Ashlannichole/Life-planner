{
  "expo": {
    "name": "Sprout",
    "slug": "sprout",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f7f4ee",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f4ee",
      "dark": {
        "backgroundColor": "#1c1e1b"
      }
    },
    "ios": {
      "bundleIdentifier": "com.ashlan.sprout",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ashlan.sprout",
      "adaptiveIcon": {
        "backgroundColor": "#e5efe6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#5d8c69"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Sprout reads your sleep, heart rate variability, steps and calories (from Oura, Apple Watch or any app that shares with Apple Health) to plan lighter days when you need them.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ]
    ]
  }
}
